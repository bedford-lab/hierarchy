p_points_all, width = 10, height = 13, dpi = 300)
cat("Saved combined points figure\n")
## Density, combined
## NOTE ON COLOR SCALE: stat_density_tern's computed "level" is in absolute
## density units, which differ in magnitude across panels (e.g. tighter
## clusters produce higher peak density than diffuse ones). Mapping fill to
## the raw level with one shared scale_fill_viridis_c() across all facets
## means low-magnitude panels never reach the top of the color scale (no
## yellow). To give every panel its own full color range, we normalize each
## panel's level to a fraction of *its own* max (via ave(..., PANEL, FUN =
## max)) before mapping to fill. Tradeoff: color now shows within-panel
## relative density, not absolute density comparable across panels. If you
## want the original shared/comparable scale back, replace
## `after_stat(level / ave(level, PANEL, FUN = max))` with `after_stat(level)`.
p_density_all <- ggtern(df, aes(x = WS, y = TT, z = VS)) +
stat_density_tern(aes(fill = after_stat(level / ave(level, PANEL, FUN = max))),
geom = "polygon", bins = 12, color = NA) +
scale_fill_viridis_c(name = "Density\n(% of panel max)", labels = scales::percent) +
facet_grid(Group ~ Sex, labeller = label_both) +
labs(title = "Ternary density heatmaps: TT / WS / VS by Group and Sex",
x = "WS", y = "TT", z = "VS") +
tern_theme +
theme(legend.position = "right")
ggsave(file.path(OUTDIR, "ternary_density_all.png"),
p_density_all, width = 11, height = 13, dpi = 300)
## ---------------------------------------------------------------------------
## Ternary plots of animal performance across three axes: TT, WS, VS
## R / ggtern implementation
##
## Input: tern_df.csv with columns
##   MouseID, Cohort, Group, Sex,
##   z_DS_norm_TT, z_TotDur_WS, z_totVol_overall_VS   (z-scored, can be negative)
##
## Produces, for each Group x Sex combination (6 panels):
##   1. Point plot      - one point per MouseID
##   2. Density heatmap - 2D kernel density estimate over the ternary simplex
##
## Outputs: 12 individual panel PNGs + 2 combined 2x3 faceted PNGs, all at 300 dpi.
##
## TRANSFORM NOTE:
## Ternary coordinates must be non-negative and sum to a constant. The raw
## z-scores are centered at 0 and can be negative, so they can't be plotted
## directly. Each axis is min-max normalized using the GLOBAL min/max across
## all animals (not per-panel), so all 6 panels share the same scale and are
## visually comparable. Rows are then closed so TT + WS + VS = 1. The plotted
## position therefore reflects each animal's *relative balance* across the
## three performance axes, not its absolute z-score.
## ---------------------------------------------------------------------------
## Install once if needed:
## install.packages(c("ggtern", "dplyr", "tidyr", "readr", "stringr", "patchwork", "scales"))
library(ggtern)
library(dplyr)
library(tidyr)
library(readr)
library(stringr)
library(patchwork)
library(scales)
## NOTE: MASS is used below via MASS::kde2d() rather than library(MASS),
## since attaching MASS masks dplyr::select().
## ---------------------------------------------------------------------------
## Config
## ---------------------------------------------------------------------------
INPUT_CSV <- "tern_df.csv"     # update path as needed
OUTDIR    <- "ternary_outputs"
dir.create(OUTDIR, showWarnings = FALSE)
GROUP_ORDER <- c("BalbC_WT", "C57_MUT", "C57_WT")
SEX_ORDER   <- c("F", "M")
GROUP_COLORS <- c(
"BalbC_WT" = "#4C72B0",
"C57_MUT"  = "#C44E52",
"C57_WT"   = "#55A868"
)
## ---------------------------------------------------------------------------
## Load + sanity check
## ---------------------------------------------------------------------------
df <- read_csv(INPUT_CSV, show_col_types = FALSE)
cat("Loaded", nrow(df), "rows\n\n")
summary_tbl <- df %>%
count(Group, Sex) %>%
complete(Group = GROUP_ORDER, Sex = SEX_ORDER, fill = list(n = 0))
cat("Sample sizes per Group x Sex:\n")
print(summary_tbl)
expected <- tibble::tribble(
~Group,      ~Sex, ~n_expected,
"BalbC_WT",  "F",  36,
"BalbC_WT",  "M",  39,
"C57_MUT",   "F",  24,
"C57_MUT",   "M",  24,
"C57_WT",    "F",  39,
"C57_WT",    "M",  39
)
check <- summary_tbl %>% left_join(expected, by = c("Group", "Sex"))
if (any(check$n != check$n_expected)) {
warning("Sample sizes differ from expected values — check grouping.")
} else {
cat("\nSample sizes match expected values.\n")
}
## ---------------------------------------------------------------------------
## Transform: global min-max normalize each axis, then close to sum = 1
## ---------------------------------------------------------------------------
minmax <- function(x) (x - min(x)) / (max(x) - min(x))
df <- df %>%
mutate(
TT_scaled = minmax(z_DS_norm_TT),
WS_scaled = minmax(z_TotDur_WS),
VS_scaled = minmax(z_totVol_overall_VS)
) %>%
mutate(row_sum = TT_scaled + WS_scaled + VS_scaled) %>%
mutate(
TT = TT_scaled / row_sum,
WS = WS_scaled / row_sum,
VS = VS_scaled / row_sum
) %>%
select(-row_sum)
cat("\nTransform check (each row should sum to 1): range =",
range(df$TT + df$WS + df$VS), "\n")
df <- df %>%
mutate(
Group = factor(Group, levels = GROUP_ORDER),
Sex   = factor(Sex, levels = SEX_ORDER)
)
## ---------------------------------------------------------------------------
## Shared theme / scale helpers
## ---------------------------------------------------------------------------
tern_theme <- theme_bw() +
theme(
tern.axis.title.T = element_text(face = "bold"),
tern.axis.title.L = element_text(face = "bold"),
tern.axis.title.R = element_text(face = "bold"),
plot.title = element_text(hjust = 0.5, size = 11),
legend.position = "none"
)
## Vertex mapping: T = TT (top), L = VS (bottom-left), R = WS (bottom-right)
## (matches the layout used in the Python/matplotlib version)
## ---------------------------------------------------------------------------
## Individual panels
## ---------------------------------------------------------------------------
panel_specs <- expand.grid(Group = GROUP_ORDER, Sex = SEX_ORDER, stringsAsFactors = FALSE)
for (i in seq_len(nrow(panel_specs))) {
g <- panel_specs$Group[i]
s <- panel_specs$Sex[i]
sub <- df %>% filter(Group == g, Sex == s)
n <- nrow(sub)
tag <- paste0(g, "_", s)
## --- point plot ---
p_points <- ggtern(sub, aes(x = WS, y = TT, z = VS)) +
geom_point(size = 2.5, color = GROUP_COLORS[[g]], alpha = 0.85) +
labs(title = paste0(g, " — ", s, " (n=", n, ")"),
x = "WS", y = "TT", z = "VS") +
tern_theme
ggsave(file.path(OUTDIR, paste0("ternary_points_", tag, ".png")),
p_points, width = 5.5, height = 5, dpi = 300)
## --- density heatmap ---
p_density <- ggtern(sub, aes(x = WS, y = TT, z = VS)) +
stat_density_tern(aes(fill = after_stat(level)), geom = "polygon",
bins = 12, color = NA) +
scale_fill_viridis_c() +
labs(title = paste0(g, " — ", s, " (n=", n, ") density"),
x = "WS", y = "TT", z = "VS") +
tern_theme
ggsave(file.path(OUTDIR, paste0("ternary_density_", tag, ".png")),
p_density, width = 5.5, height = 5, dpi = 300)
cat("Saved panels for", tag, "\n")
}
## ---------------------------------------------------------------------------
## Combined 2x3 faceted figures (rows = Group, cols = Sex)
## ---------------------------------------------------------------------------
## Points, combined (ggtern facets natively via facet_wrap)
p_points_all <- ggtern(df, aes(x = WS, y = TT, z = VS, color = Group)) +
geom_point(size = 1.8, alpha = 0.8) +
scale_color_manual(values = GROUP_COLORS) +
facet_grid(Group ~ Sex, labeller = label_both) +
labs(title = "Ternary point plots: TT / WS / VS by Group and Sex",
x = "WS", y = "TT", z = "VS") +
tern_theme +
theme(legend.position = "none")
ggsave(file.path(OUTDIR, "ternary_points_all.png"),
p_points_all, width = 10, height = 13, dpi = 300)
cat("Saved combined points figure\n")
## Density, combined
## NOTE ON COLOR SCALE: stat_density_tern's computed "level" is in absolute
## density units, which differ in magnitude across panels (e.g. tighter
## clusters produce higher peak density than diffuse ones). Mapping fill to
## the raw level with one shared scale_fill_viridis_c() across all facets
## means low-magnitude panels never reach the top of the color scale (no
## yellow). To give every panel its own full color range, we normalize each
## panel's level to a fraction of *its own* max (via ave(..., PANEL, FUN =
## max)) before mapping to fill. Tradeoff: color now shows within-panel
## relative density, not absolute density comparable across panels. If you
## want the original shared/comparable scale back, replace
## `after_stat(level / ave(level, PANEL, FUN = max))` with `after_stat(level)`.
p_density_all <- ggtern(df, aes(x = WS, y = TT, z = VS)) +
stat_density_tern(aes(fill = after_stat(level / ave(level, PANEL, FUN = max))),
geom = "polygon", bins = 12, color = NA) +
scale_fill_viridis_c(name = "Density\n(% of panel max)", labels = scales::percent) +
facet_grid(Group ~ Sex, labeller = label_both) +
labs(title = "Ternary density heatmaps: TT / WS / VS by Group and Sex",
x = "WS", y = "TT", z = "VS") +
tern_theme +
theme(legend.position = "right")
ggsave(file.path(OUTDIR, "ternary_density_all.png"),
p_density_all, width = 11, height = 13, dpi = 300)
## ---------------------------------------------------------------------------
## Ternary plots of animal performance across three axes: TT, WS, VS
## R / ggtern implementation
##
## Input: tern_df.csv with columns
##   MouseID, Cohort, Group, Sex,
##   z_DS_norm_TT, z_TotDur_WS, z_totVol_overall_VS   (z-scored, can be negative)
##
## Produces, for each Group x Sex combination (6 panels):
##   1. Point plot      - one point per MouseID
##   2. Density heatmap - 2D kernel density estimate over the ternary simplex
##
## Outputs: 12 individual panel PNGs + 2 combined 2x3 faceted PNGs, all at 300 dpi.
##
## TRANSFORM NOTE:
## Ternary coordinates must be non-negative and sum to a constant. The raw
## z-scores are centered at 0 and can be negative, so they can't be plotted
## directly. Each axis is min-max normalized using the GLOBAL min/max across
## all animals (not per-panel), so all 6 panels share the same scale and are
## visually comparable. Rows are then closed so TT + WS + VS = 1. The plotted
## position therefore reflects each animal's *relative balance* across the
## three performance axes, not its absolute z-score.
## ---------------------------------------------------------------------------
## Install once if needed:
## install.packages(c("ggtern", "dplyr", "tidyr", "readr", "stringr", "patchwork", "scales"))
## (MASS ships with base R and is used via MASS::kde2d() below; no install needed
## unless your R distribution has removed it.)
library(ggtern)
library(dplyr)
library(tidyr)
library(readr)
library(stringr)
library(patchwork)
library(scales)
## NOTE: MASS is used below via MASS::kde2d() rather than library(MASS),
## since attaching MASS masks dplyr::select().
## ---------------------------------------------------------------------------
## Config
## ---------------------------------------------------------------------------
INPUT_CSV <- "tern_df.csv"     # update path as needed
OUTDIR    <- "ternary_outputs"
dir.create(OUTDIR, showWarnings = FALSE)
GROUP_ORDER <- c("BalbC_WT", "C57_MUT", "C57_WT")
SEX_ORDER   <- c("F", "M")
GROUP_COLORS <- c(
"BalbC_WT" = "#4C72B0",
"C57_MUT"  = "#C44E52",
"C57_WT"   = "#55A868"
)
## ---------------------------------------------------------------------------
## Load + sanity check
## ---------------------------------------------------------------------------
df <- read_csv(INPUT_CSV, show_col_types = FALSE)
cat("Loaded", nrow(df), "rows\n\n")
summary_tbl <- df %>%
count(Group, Sex) %>%
complete(Group = GROUP_ORDER, Sex = SEX_ORDER, fill = list(n = 0))
cat("Sample sizes per Group x Sex:\n")
print(summary_tbl)
expected <- tibble::tribble(
~Group,      ~Sex, ~n_expected,
"BalbC_WT",  "F",  36,
"BalbC_WT",  "M",  39,
"C57_MUT",   "F",  24,
"C57_MUT",   "M",  24,
"C57_WT",    "F",  39,
"C57_WT",    "M",  39
)
check <- summary_tbl %>% left_join(expected, by = c("Group", "Sex"))
if (any(check$n != check$n_expected)) {
warning("Sample sizes differ from expected values — check grouping.")
} else {
cat("\nSample sizes match expected values.\n")
}
## ---------------------------------------------------------------------------
## Transform: global min-max normalize each axis, then close to sum = 1
## ---------------------------------------------------------------------------
minmax <- function(x) (x - min(x)) / (max(x) - min(x))
df <- df %>%
mutate(
TT_scaled = minmax(z_DS_norm_TT),
WS_scaled = minmax(z_TotDur_WS),
VS_scaled = minmax(z_totVol_overall_VS)
) %>%
mutate(row_sum = TT_scaled + WS_scaled + VS_scaled) %>%
mutate(
TT = TT_scaled / row_sum,
WS = WS_scaled / row_sum,
VS = VS_scaled / row_sum
) %>%
select(-row_sum)
cat("\nTransform check (each row should sum to 1): range =",
range(df$TT + df$WS + df$VS), "\n")
df <- df %>%
mutate(
Group = factor(Group, levels = GROUP_ORDER),
Sex   = factor(Sex, levels = SEX_ORDER)
)
## ---------------------------------------------------------------------------
## Shared theme / scale helpers
## ---------------------------------------------------------------------------
tern_theme <- theme_bw() +
theme(
tern.axis.title.T = element_text(face = "bold"),
tern.axis.title.L = element_text(face = "bold"),
tern.axis.title.R = element_text(face = "bold"),
plot.title = element_text(hjust = 0.5, size = 11),
legend.position = "none"
)
## Vertex mapping: T = TT (top), L = VS (bottom-left), R = WS (bottom-right)
## (matches the layout used in the Python/matplotlib version)
## ---------------------------------------------------------------------------
## Individual panels
## ---------------------------------------------------------------------------
panel_specs <- expand.grid(Group = GROUP_ORDER, Sex = SEX_ORDER, stringsAsFactors = FALSE)
for (i in seq_len(nrow(panel_specs))) {
g <- panel_specs$Group[i]
s <- panel_specs$Sex[i]
sub <- df %>% filter(Group == g, Sex == s)
n <- nrow(sub)
tag <- paste0(g, "_", s)
## --- point plot ---
p_points <- ggtern(sub, aes(x = WS, y = TT, z = VS)) +
geom_point(size = 2.5, color = GROUP_COLORS[[g]], alpha = 0.85) +
labs(title = paste0(g, " — ", s, " (n=", n, ")"),
x = "WS", y = "TT", z = "VS") +
tern_theme
ggsave(file.path(OUTDIR, paste0("ternary_points_", tag, ".png")),
p_points, width = 5.5, height = 5, dpi = 300)
## --- density heatmap ---
p_density <- ggtern(sub, aes(x = WS, y = TT, z = VS)) +
stat_density_tern(aes(fill = after_stat(level)), geom = "polygon",
bins = 12, color = NA) +
scale_fill_viridis_c() +
labs(title = paste0(g, " — ", s, " (n=", n, ") density"),
x = "WS", y = "TT", z = "VS") +
tern_theme
ggsave(file.path(OUTDIR, paste0("ternary_density_", tag, ".png")),
p_density, width = 5.5, height = 5, dpi = 300)
cat("Saved panels for", tag, "\n")
}
## ---------------------------------------------------------------------------
## Combined 2x3 faceted figures (rows = Group, cols = Sex)
## ---------------------------------------------------------------------------
## Points, combined (ggtern facets natively via facet_wrap)
p_points_all <- ggtern(df, aes(x = WS, y = TT, z = VS, color = Group)) +
geom_point(size = 1.8, alpha = 0.8) +
scale_color_manual(values = GROUP_COLORS) +
facet_grid(Group ~ Sex, labeller = label_both) +
labs(title = "Ternary point plots: TT / WS / VS by Group and Sex",
x = "WS", y = "TT", z = "VS") +
tern_theme +
theme(legend.position = "none")
ggsave(file.path(OUTDIR, "ternary_points_all.png"),
p_points_all, width = 10, height = 13, dpi = 300)
cat("Saved combined points figure\n")
## Density, combined
## NOTE ON APPROACH: stat_density_tern()'s internal computation of polygon
## "ymax" breaks when after_stat() references PANEL (a known ggtern/ggplot2
## internals conflict). To avoid it, and to give every panel its own full
## color range (so each panel shows some bright yellow at its own peak
## density, not just the panel with the highest absolute density), density
## contours are computed manually here:
##   1. Convert each panel's (TT, WS, VS) points to 2D cartesian coordinates
##      inside the triangle.
##   2. Estimate a 2D kernel density (MASS::kde2d) on a grid.
##   3. Mask grid cells outside the triangle.
##   4. Normalize density to a fraction of that panel's own max (0-1).
##   5. Extract contour polygons (grDevices::contourLines) and convert back
##      to ternary (TT, WS, VS) coordinates.
##   6. Combine all panels' contours into one data frame and plot with a
##      plain geom_polygon() (no stat), faceted by Group x Sex.
## TRADEOFF: color now reflects each panel's WITHIN-panel relative density
## (0-100% of its own peak), not absolute density comparable across panels.
## If you want a single shared/comparable scale instead, see the commented
## alternative at the bottom of this block.
V_TT <- c(0.5, sqrt(3) / 2)
V_WS <- c(1, 0)
V_VS <- c(0, 0)
tern_to_cart <- function(tt, ws, vs) {
x <- tt * V_TT[1] + ws * V_WS[1] + vs * V_VS[1]
y <- tt * V_TT[2] + ws * V_WS[2] + vs * V_VS[2]
list(x = x, y = y)
}
cart_to_tern <- function(x, y) {
tt <- 2 * y / sqrt(3)
ws <- x - 0.5 * tt
vs <- 1 - tt - ws
list(TT = tt, WS = ws, VS = vs)
}
compute_density_contours <- function(sub, group, sex, n_grid = 200,
levels = seq(0.05, 0.95, length.out = 10)) {
if (nrow(sub) < 3) return(NULL)
xy <- tern_to_cart(sub$TT, sub$WS, sub$VS)
kd <- MASS::kde2d(xy$x, xy$y, n = n_grid, lims = c(0, 1, 0, sqrt(3) / 2))
## mask grid cells outside the triangle
xg <- kd$x; yg <- kd$y
outside <- outer(xg, yg, function(x, y) {
!(y <= sqrt(3) * x + 1e-9 & y <= sqrt(3) * (1 - x) + 1e-9)
})
zmat <- kd$z
zmat[outside] <- 0
maxz <- max(zmat, na.rm = TRUE)
if (!is.finite(maxz) || maxz <= 0) return(NULL)
zmat_norm <- zmat / maxz
cl <- grDevices::contourLines(x = xg, y = yg, z = zmat_norm, levels = levels)
if (length(cl) == 0) return(NULL)
pieces <- lapply(seq_along(cl), function(k) {
piece <- cl[[k]]
tern <- cart_to_tern(piece$x, piece$y)
data.frame(
Group = group, Sex = sex,
piece_id = paste(group, sex, k, sep = "_"),
level = piece$level,
TT = tern$TT, WS = tern$WS, VS = tern$VS
)
})
do.call(rbind, pieces)
}
density_contours <- lapply(seq_len(nrow(panel_specs)), function(i) {
g <- panel_specs$Group[i]
s <- panel_specs$Sex[i]
sub <- df %>% filter(Group == g, Sex == s)
compute_density_contours(sub, g, s)
})
density_contours_df <- do.call(rbind, density_contours)
density_contours_df$Group <- factor(density_contours_df$Group, levels = GROUP_ORDER)
density_contours_df$Sex   <- factor(density_contours_df$Sex, levels = SEX_ORDER)
p_density_all <- ggtern(density_contours_df,
aes(x = WS, y = TT, z = VS, group = piece_id, fill = level)) +
geom_polygon(color = NA) +
scale_fill_viridis_c(name = "Density\n(% of panel max)", labels = scales::percent,
limits = c(0, 1)) +
facet_grid(Group ~ Sex, labeller = label_both) +
labs(title = "Ternary density heatmaps: TT / WS / VS by Group and Sex",
x = "WS", y = "TT", z = "VS") +
tern_theme +
theme(legend.position = "right")
## Alternative: for a single scale shared/comparable across all panels
## (original behavior, but low-density panels won't show yellow), go back to
## stat_density_tern() without the PANEL-based normalization:
##   p_density_all <- ggtern(df, aes(x = WS, y = TT, z = VS)) +
##     stat_density_tern(aes(fill = after_stat(level)), geom = "polygon",
##                        bins = 12, color = NA) +
##     scale_fill_viridis_c() +
##     facet_grid(Group ~ Sex, labeller = label_both) + tern_theme
ggsave(file.path(OUTDIR, "ternary_density_all.png"),
p_density_all, width = 11, height = 13, dpi = 300)
cat("Saved combined density figure\n")
cat("\nDone. All outputs in", OUTDIR, "\n")
p_density_all
print(summary_tbl)
check <- summary_tbl %>% left_join(expected, by = c("Group", "Sex"))
check
df <- df %>%
mutate(
TT_scaled = minmax(z_DS_norm_TT),
WS_scaled = minmax(z_TotDur_WS),
VS_scaled = minmax(z_totVol_overall_VS)
) %>%
mutate(row_sum = TT_scaled + WS_scaled + VS_scaled) %>%
mutate(
TT = TT_scaled / row_sum,
WS = WS_scaled / row_sum,
VS = VS_scaled / row_sum
)
View(df)
df <- df %>%
mutate(
TT_scaled = minmax(z_DS_norm_TT),
WS_scaled = minmax(z_TotDur_WS),
VS_scaled = minmax(z_totVol_overall_VS)
) %>%
mutate(row_sum = TT_scaled + WS_scaled + VS_scaled) %>%
mutate(
TT = TT_scaled / row_sum,
WS = WS_scaled / row_sum,
VS = VS_scaled / row_sum
) %>%
mutate(sum = TT + WS + VS)
df <- df %>%
mutate(
TT_scaled = minmax(z_DS_norm_TT),
WS_scaled = minmax(z_TotDur_WS),
VS_scaled = minmax(z_totVol_overall_VS)
) %>%
mutate(row_sum = TT_scaled + WS_scaled + VS_scaled) %>%
mutate(
TT = TT_scaled / row_sum,
WS = WS_scaled / row_sum,
VS = VS_scaled / row_sum
) %>%
mutate(sum = TT + WS + VS,
specialization = sqrt((TT - 1/3)^2 + (WS - 1/3)^2 + (VS - 1/3)^2),
consistency = 1 - specialization / sqrt(2/3))
m1 <- lmer(specialization ~ Group * Sex + (1|Cohort), data = df)
m1 <- lm(specialization ~ Group * Sex, data = df)
summary(m1)
pairs(emmeans(m16, ~ Sex))
pairs(emmeans(m16, ~ Group))
pairs(emmeans(m16, ~ Group | Sex))
ggplot(data = df, aes(x = Group, y = specialization)) + facet_wrap(~Sex)
ggplot(data = df, aes(x = Group, y = specialization)) + geom_boxplot() + facet_wrap(~Sex)
cat("\nTransform check (each row should sum to 1): range =",
range(df$TT + df$WS + df$VS), "\n")
df <- df %>%
mutate(
Group = factor(Group, levels = GROUP_ORDER),
Sex   = factor(Sex, levels = SEX_ORDER)
)
